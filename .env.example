# --- LLM (Gemini is default; any OpenAI-compatible endpoint works) ---
# Leave empty to use the deterministic offline heuristics.
GEMINI_API_KEY=your-google-ai-studio-key
# Optional overrides:
# FUSION_AI_MODEL=gemini-2.5-flash
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=   # instead of GEMINI_API_KEY for OpenAI or other providers

# --- Fusion bridge ---
# mock        built-in simulation (default, zero setup)
# faust       faust-machines fusion360-mcp-server -> Fusion add-in (socket :9876)
# faust-mock  same server in its own mock mode (real MCP protocol, no Fusion)
# stdio|http  raw generic modes
FUSION_AI_MODE=mock
# Optional custom command/URL. The defaults (used when unset) are:
#   uvx --link-mode copy --with mcp==1.30.0 fusion360-mcp-server --mode socket
#   uvx --link-mode copy --with mcp==1.30.0 fusion360-mcp-server --mode mock
# Keep mcp pinned: 1.17.x breaks the server's low-level API.
# FUSION_MCP_COMMAND=uvx --link-mode copy --with mcp==1.30.0 fusion360-mcp-server --mode socket
# FUSION_MCP_URL=http://localhost:8000/mcp

# --- Safety limits ---
# FUSION_AI_MAX_REPAIRS=3
# FUSION_AI_MAX_PLAN_STEPS=40
# FUSION_AI_APPROVAL_TIMEOUT=600

# --- Storage ---
# FUSION_AI_DATA_DIR=~/.fusion-ai-agent
